{
    "name": "sijanmahato/laravel-email-configuration",
    "description": "Database-driven email templates with admin API, placeholder replacement, and test send.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/sijanmahato/laravel-email-configuration",
    "support": {
        "issues": "https://github.com/sijanmahato/laravel-email-configuration/issues",
        "source": "https://github.com/sijanmahato/laravel-email-configuration"
    },
    "authors": [
        {
            "name": "Karja Suchana Kendra Limited"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Karja\\EmailConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karja\\EmailConfig\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karja\\EmailConfig\\EmailConfigServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
